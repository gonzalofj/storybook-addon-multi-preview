{
  "name": "storybook-addon-multi-preview",
  "version": "1.0.0",
  "description": "Storybook toolbar addon that renders the active story in several Storybook viewports side by side, each in a real iframe",
  "keywords": [
    "storybook",
    "storybook-addon",
    "essentials",
    "preview",
    "viewport",
    "responsive",
    "multi-preview",
    "multi",
    "multiple"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gonzalofj/storybook-addon-multi-preview.git"
  },
  "license": "MIT",
  "author": "Gonzalo Ferreyra",
  "homepage": "https://gonzalofj.github.io/storybook-addon-multi-preview/",
  "bugs": {
    "url": "https://github.com/gonzalofj/storybook-addon-multi-preview/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "build:watch": "bun run build -- --watch",
    "prepack": "bun run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.tsx"
    ],
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "react": "^19",
    "storybook": "^10.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "storybook": "^10.0.0"
  },
  "storybook": {
    "displayName": "Multi Preview",
    "supportedFrameworks": [
      "react"
    ],
    "icon": "https://raw.githubusercontent.com/gonzalofj/storybook-addon-multi-preview/main/assets/icon.png"
  }
}
